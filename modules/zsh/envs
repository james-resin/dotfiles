export EDITOR=nvim
export ZSH="$HOME/.oh-my-zsh"

# Default is 40 (0.4s). Wayland clipboard reads require a round trip to the
# source app to hand over the data, so on a slow/busy source the paste can
# arrive in delayed chunks; if the "ESC [ 200 ~" bracketed-paste-start
# sequence doesn't land within KEYTIMEOUT, zle treats ESC as a bare Meta key
# and prints the rest of the sequence literally instead of starting a paste.
# tmux doesn't hit this because it already holds the buffer locally and
# writes it to the pty in one fast burst. Bump the timeout to give slow
# pastes more slack outside tmux.
export KEYTIMEOUT=100

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/odin:$HOME/ols:/opt/cuda/bin:$PATH"

[ -f /opt/miniconda3/etc/profile.d/conda.sh ] && source /opt/miniconda3/etc/profile.d/conda.sh
